# --- Database (Neon) ---
# From Neon Console -> your project -> Connect. Grab BOTH connection strings:
#
#   DATABASE_URL  = the "Pooled connection" (host ends in -pooler.neon.tech).
#                   Used by the app at runtime (Vercel serverless). Add
#                   ?sslmode=require (and ?pgbouncer=true if it's not already
#                   there) — Neon requires SSL.
#
#   DIRECT_URL    = the "Direct connection" (no -pooler, host is ep-*.neon.tech).
#                   Used by Prisma for migrations / db push. Add ?sslmode=require.
#
# Example (NOT real — replace with your own):
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL=""
DIRECT_URL=""

# --- Twitch (https://dev.twitch.tv/console/apps) ---
# Create an application there to get a Client ID and Client Secret.
# These are used server-side only and are never exposed to the browser.
# Live status fails soft to "offline" if these are missing, so the site
# still works without them.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_USERNAME="yourchannel"

# --- Site identity ---
STREAMER_NAME="Your Name"
SITE_NAME="Schedule"
SITE_DESCRIPTION="A developer streaming log — past, current, and upcoming streams."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
GITHUB_URL=""
YOUTUBE_URL=""

# --- Admin auth ---
# Used once by `npm run db:seed` to create your admin login. Change the
# password after seeding if you like — it's just used to create the row.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# NextAuth requires a random secret. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Set to "true" to seed a sample series + two sample streams so the homepage
# isn't empty on first run. Safe to leave unset/false once you have real data.
SEED_SAMPLE_DATA="false"
